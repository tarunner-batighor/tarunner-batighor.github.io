# ============================================================
#  তারুণ্যের বাতিঘর — functions/.env
# ============================================================
#  সাধারণত এখানে কিছু লিখতে হয় না:
#  - Firebase service account (credentials) — Firebase নিজেই
#    deploy-এর সময় দেয় (GOOGLE_APPLICATION_CREDENTIALS)
#  - FCM Web Push-এর VAPID key — Firebase Console-এ Web Push
#    certificate generate করলে FCM নিজেই সেটা ব্যবহার করে
#
#  শুধু তাই যদি FCM Web Push কাজ না করে (console লগে
#  "vapid" ভুল থাকে), তখন নিচের দুটো বসিয়ে আবার deploy:
#
#  FCM_WEB_PUSH_PRIVATE_KEY=-----BEGIN PRIVATE KEY----- ... (Console থেকে download করা private key, এক লাইনে)
#  FCM_VAPID_SUBJECT=mailto:abdulhadibinmasud775@gmail.com
