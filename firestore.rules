rules_version = '2';

// ============================================================
//  তারুণ্যের বাতিঘর — Firestore Security Rules (v4 — Moderator system)
//  v3-এর ওপর নতুন:
//  - isModerator(): users/{uid}.role == 'moderator'
//  - isStaff() = admin OR moderator
//  - moderator: পোস্ট edit/approve/reject, comment moderation,
//    notifications + pushQueue create
//  - role field protection: কেউ নিজে নিজে role বদলাতে/যুক্ত করতে
//    পারবে না — শুধু Admin (email-based) set করতে পারবে
//  - Post hard-delete + user management: শুধু Admin
//  v3-এর বিদ্যমান সব rule অক্ষত রাখা হয়েছে।
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Admin — শুধু নির্দিষ্ট ইমেইলের লগইন করা ব্যবহারকারী
    function isAdmin() {
      return isSignedIn()
        && request.auth.token.email == 'abdulhadibinmasud775@gmail.com';
    }

    // Moderator — নিজের user doc-এ role == 'moderator'
    // (এই field শুধু Admin Admin Panel-এর Moderators tab থেকে
    //  set করে — নিজে নিজে change করা নিচের role protection-এ ব্লক)
    function isModerator() {
      return isSignedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid))
             .data.get('role', null) == 'moderator';
    }

    // Admin + Moderator — একসাথে moderation work করবে
    function isStaff() {
      return isAdmin() || isModerator();
    }

    match /Posts/{postId} {

      /* শুধু published পোস্টের engagement public — pending/rejected
         পোস্টের reaction/comment কেউ পড়তে পারবে না */
      function parentIsPublished() {
        return get(/databases/$(database)/documents/Posts/$(postId)).data.status == 'published';
      }

      // পড়া (read):
      //   - সবাই শুধু 'published' পোস্ট পড়তে পারবে
      //   - লেখক নিজে নিজের পোস্ট (pending/rejected) পড়তে পারবে
      //   - Admin ও Moderator সব পোস্ট পড়তে পারবে
      allow get, list: if resource.data.status == 'published'
        || (isSignedIn() && resource.data.authorUid == request.auth.uid)
        || isStaff();

      // নতুন পোস্ট জমা দেওয়া (create):
      //   - শুধু লগইন করা user (Google Login)
      //   - status চিরকাল 'pending' — কেউ সরাসরি 'published'
      //     লিখে দিতে পারবে না
      //   - authorUid অবশ্যই নিজের uid হতে হবে
      allow create: if isSignedIn()
        && request.resource.data.status == 'pending'
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 300
        && request.resource.data.content is string
        && request.resource.data.content.size() > 0
        && request.resource.data.content.size() <= 100000
        && request.resource.data.category is string
        && request.resource.data.category.size() > 0
        && request.resource.data.category.size() <= 50;

      // পোস্ট বদলানো (update):
      //   - Admin + Moderator: যেকোনো field
      //     (edit / approve / reject / audit field)
      //   - কেউই (login ছাড়াও): শুধু viewCount field —
      //     বাকি field-এ হাত দিলে deny (view count guard)
      allow update: if isStaff()
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewCount']);

      // মোছা (delete): শুধু Admin —
      // moderator পোস্ট হার্ড-ডিলিট করতে পারবে না
      allow delete: if isAdmin();

      /* ---- Reaction:
         - doc id = user-এর নিজের uid
         - প্রতি user-এর প্রতি পোস্টে মাত্র ১টা reaction
         - নিজের reaction create/update/delete; অন্যের নয় */
      match /reactions/{uid} {
        allow read: if parentIsPublished();
        allow create, update: if isSignedIn()
          && request.auth.uid == uid
          && parentIsPublished()
          && request.resource.data.emoji is string
          && request.resource.data.emoji.size() > 0
          && request.resource.data.emoji.size() <= 8;
        allow delete: if isSignedIn()
          && request.auth.uid == uid
          && parentIsPublished();
      }

      /* ---- Comment:
         - শুধু login করা user লিখতে পারবে
         - authorUid অবশ্যই নিজের uid
         - ২-৫০০ অক্ষর, authorName ১-৮০ অক্ষর
         - update/delete: Admin + Moderator (মডারেশন) */
      match /comments/{cid} {
        allow read: if parentIsPublished();
        allow create: if isSignedIn()
          && parentIsPublished()
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.authorName is string
          && request.resource.data.authorName.size() > 0
          && request.resource.data.authorName.size() <= 80
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 2
          && request.resource.data.text.size() <= 500;
        allow update: if isStaff();
        allow delete: if isStaff();
      }
    }

    match /users/{uid} {

      // নিজের account — শুধু নিজেকে পড়তে পারবে
      allow get: if isSignedIn() && request.auth.uid == uid;

      // পুরো users তালিকা — শুধু Admin (moderator খোঁজার জন্য)
      allow list: if isAdmin();

      // নিজের profile বদলাতে পারবে —
      // কিন্তু role field-এ হাত দিতে পারবে না
      // (privilege escalation ব্লক)
      allow update: if isSignedIn()
        && request.auth.uid == uid
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']);

      // নতুন account খোলা — শুধু নিজের জন্য, email verify করা,
      // এবং create-তে role field দেওয়া যাবে না
      allow create: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.get('role', null) == null;

      // Admin: অন্যের user doc পড়া/বদলানো
      // (moderator role set/remove-এর জন্য)
      allow get, update: if isAdmin();

      allow delete: if false;

      // Notification:
      //   - মালিক পড়তে / read-mark করতে পারবে
      //   - create: Admin/Moderator panel (client)
      //     + Cloud Function (service account)
      match /notifications/{notifId} {
        allow get, list, update: if isSignedIn() && request.auth.uid == uid;
        allow delete: if false;
        allow create: if isStaff();
      }

      // Push token:
      //   - মালিক নিজের ডিভাইস/ব্রাউজারের token manage করবে
      match /pushTokens/{tokenId} {
        allow get, list, create, update, delete:
          if isSignedIn() && request.auth.uid == uid;
      }
    }

    /* Push Queue:
       - Admin/Moderator accept/reject করলে এই queue-তে
         item আসে (client)
       - পড়া/লিখা (push + cleanup) শুধু service account
         (GitHub Actions / Cloud Function) করবে */
    match /pushQueue/{docId} {
      allow create: if isStaff();
      allow read, update, delete: if false;
    }
  }
}
